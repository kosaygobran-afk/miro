    "main.py": {
      "maxDuration": 60,
      "excludeFiles": "{test_*.py,__pycache__/**,.venv/**,Dockerfile,requirements-test.txt}"
    }
  },
  "installCommand": "uv pip install --python .vercel/python/.venv/bin/python -r requirements.txt",
