NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=MIRO
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=products
# Optional public contact overrides. When set, these take precedence over the
# public.get_public_contact_config() RPC values. Leave empty to use the
# database-managed config. Values must validate, otherwise the matching
# contact actions are hidden (placeholders are never rendered).
# Phone in international format (e.g. +972501234567).
NEXT_PUBLIC_CONTACT_PHONE=
# WhatsApp number: digits only, with country code (e.g. 972501234567).
NEXT_PUBLIC_CONTACT_WHATSAPP=
# Public contact email address.
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional for trusted administrative scripts only; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
