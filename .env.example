NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=MIRO
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=products
# Optional private image worker. Leave URL empty to preserve originals.
BACKGROUND_REMOVAL_WORKER_URL=
BACKGROUND_REMOVAL_WORKER_TOKEN=
BACKGROUND_REMOVAL_TIMEOUT_MS=30000
# Optional public contact defaults for fields that have never been saved in
# CEO Settings, or when the public contact configuration is unavailable.
# A valid saved value takes precedence. Explicitly clearing a saved field
# hides its action while the public configuration is available.
# Phone in international format (e.g. +972501234567).
NEXT_PUBLIC_CONTACT_PHONE=
# WhatsApp number: digits only, with country code (e.g. 972501234567).
NEXT_PUBLIC_CONTACT_WHATSAPP=
# Public contact email address.
NEXT_PUBLIC_CONTACT_EMAIL=
# Required for server-side admin operations; never expose to the browser.
SUPABASE_SECRET_KEY=
