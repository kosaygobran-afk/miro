# Implemented server environment contract. Empty credentials only.
# Merge these names into the deployment secret manager; never NEXT_PUBLIC_.
# Existing Supabase/auth configuration remains separate.
COMMERCE_PUBLIC_CHECKOUT_ENABLED=false
COMMERCE_GATEWAY_ENABLED=false
COMMERCE_PRODUCTION_APPROVED=false
COMMERCE_APP_ORIGIN=
PAYPLUS_ENVIRONMENT=sandbox

PAYPLUS_SANDBOX_API_KEY=
PAYPLUS_SANDBOX_SECRET_KEY=
PAYPLUS_SANDBOX_PAGE_UID=
# Explicit account-backed methods: credit_card,bit. Blank disables all methods.
PAYPLUS_SANDBOX_ENABLED_METHODS=
# Implemented modules only: installments,partialRefund. Others remain disabled.
PAYPLUS_SANDBOX_ENABLED_FEATURES=
PAYPLUS_SANDBOX_HOSTED_PAYMENT_HOSTS=
PAYPLUS_SANDBOX_RETURN_HOSTS=

PAYPLUS_PRODUCTION_API_KEY=
PAYPLUS_PRODUCTION_SECRET_KEY=
PAYPLUS_PRODUCTION_PAGE_UID=
PAYPLUS_PRODUCTION_ENABLED_METHODS=
PAYPLUS_PRODUCTION_ENABLED_FEATURES=
PAYPLUS_PRODUCTION_HOSTED_PAYMENT_HOSTS=
PAYPLUS_PRODUCTION_RETURN_HOSTS=

# GET /api/commerce/jobs requires Bearer <secret>, at least 32 random characters.
# Schedule it externally after isolated/Supabase/sandbox verification.
COMMERCE_JOB_AUTH_SECRET=

# Independent documents are draft-only in implemented code/SQL.
# No environment switch enables official issuance/signing/allocation/recurring,
# MASAV, no-obligo, wallets, EMV or Tap-on-Phone. Obtain provider/accountant
# approval and implement/verify a concrete adapter before adding activation.
